# DeckForge AI environment configuration (placeholders only - never commit real values)
#
# Every key below is one `apps/api/config.py:load_settings()` or the frontend
# actually reads, and a pytest asserts that. This file was corrected in M8:
# it previously advertised MODEL_CACHE_DIR, BASE_MODEL_ID, LORA_WEIGHTS_PATH,
# ALLOWED_UPLOAD_EXTENSIONS and UPLOAD_TMP_DIR, none of which any code reads.
# Someone setting the project up from this file would have configured five
# things that do nothing, which is worse than documenting nothing at all.
#
# EVERY KEY IS OPTIONAL. The defaults shown are the ones the service uses when
# the variable is absent, so the application runs correctly with no .env at all.

# --- API server --------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated. Restricted to the known frontend origin on purpose.
ALLOWED_ORIGINS=http://localhost:5173

# --- Uploads (untrusted input) -----------------------------------------------
# The byte limit is the only upload rule that is configurable. The allowed
# extensions, the allowed content types, the decoded-format allowlist and the
# 4096 px dimension cap are FROZEN IN CODE in apps/api/uploads.py, deliberately:
# a security rule that can be relaxed by an environment variable is not a rule.
MAX_UPLOAD_SIZE_MB=10

# --- Generation --------------------------------------------------------------
# Seconds. Enforced inside the denoising loop, so a timeout means the work
# actually stopped. Exceeding it returns 504 with the step count reached.
GENERATION_TIMEOUT_SECONDS=120

# Used when a request omits `seed`.
DEFAULT_SEED=42

# --- Paths -------------------------------------------------------------------
# Where generated PNGs are written. Defaults to <repo>/outputs/api (git-ignored).
# GENERATED_OUTPUT_DIR=./outputs/api

# The root the three production LoRA adapters are resolved under - they are
# expected at <root>/outputs/lora/<run-dir>/step<NNNNN>/pytorch_lora_weights.safetensors
# and are verified by SHA-256 on every style activation. Defaults to the
# repository root. Set this only if the weights live outside the repository;
# see docs/deployment/weights-manifest.md.
# CHECKPOINT_ROOT=

# --- Frontend (Vite; must be prefixed VITE_ to be exposed to the browser) -----
VITE_API_BASE_URL=http://127.0.0.1:8000

# Set to 1 to expose the review-only tools (texture-fit selector, inverted-UV
# demonstration) on a dev server. Never set this for a demo or a production
# build. The URL parameter ?review=1 does the same thing for a built frontend.
# VITE_REVIEW_MODE=1

# --- Worker count: NOT a tuning knob -----------------------------------------
# WEB_CONCURRENCY, UVICORN_WORKERS and GUNICORN_WORKERS are READ ONLY TO BE
# REJECTED. Any value above 1 raises ConfigurationError before the pipeline is
# built. The single-flight lock is process-local and the GPU has roughly 200 MiB
# spare with one resident pipeline, so a second worker cannot fit and would not
# share the lock. Start the service with: --workers 1
