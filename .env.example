# DeckForge AI environment configuration (placeholders only — never commit real values)

# API server
API_HOST=127.0.0.1
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173

# Upload handling (uploads are untrusted input)
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=png,jpg,jpeg,webp
