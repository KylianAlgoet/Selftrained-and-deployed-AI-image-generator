BASE_MODEL_ID=placeholder-base-model-id
LORA_WEIGHTS_PATH=./models/lora/placeholder.safetensors
DEFAULT_SEED=42
GENERATION_TIMEOUT_SECONDS=120

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
