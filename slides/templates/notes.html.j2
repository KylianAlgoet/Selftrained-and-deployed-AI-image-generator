<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ document.title }} — speaker notes</title>
<style>
{{ css }}

/* The speaker-notes handout. A4 portrait, one slide per page, printed to be held.
 * It shares no styling with the deck on purpose: this is read at arm's length by one
 * person, so it is dense where the deck is sparse. */
@page { size: A4; margin: 18mm 18mm 16mm; }

html, body { background: #fff; color: #11151c; font-size: 11pt; }

.note-page {
  break-after: page;
  page-break-after: always;
  height: 100%;
}
.note-page:last-child { break-after: auto; page-break-after: auto; }

.note-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  border-bottom: 0.6mm solid #11151c;
  padding-bottom: 2.5mm;
  margin-bottom: 5mm;
}
.note-head h2 { font-size: 16pt; margin: 0; font-weight: 650; line-height: 1.2; }
.note-head .n { font-size: 11pt; color: #7b8794; white-space: nowrap; padding-left: 8mm; }

.note-meta {
  font-size: 9.5pt;
  color: #46525f;
  margin-bottom: 5mm;
  letter-spacing: 0.02em;
}
.note-meta .tier-core { color: #15803d; font-weight: 700; }
.note-meta .tier-supporting { color: #b45309; font-weight: 700; }

.note-section-label {
  font-size: 8.5pt;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: #7b8794;
  font-weight: 700;
  margin: 0 0 2.5mm;
}

.note-slide-copy {
  background: #f4f6f9;
  border: 0.3mm solid #d9dee6;
  border-radius: 1.5mm;
  padding: 4mm 5mm;
  font-size: 10pt;
  line-height: 1.4;
  margin-bottom: 6mm;
}
.note-slide-copy ul { margin: 0; padding-left: 5mm; }
.note-slide-copy li { margin-bottom: 1.5mm; }
.note-slide-copy p { margin: 0 0 2mm; }
.note-slide-copy p:last-child, .note-slide-copy li:last-child { margin-bottom: 0; }
.note-slide-copy figure { display: none; } /* the handout carries words, not pictures */
.note-slide-copy table { width: 100%; border-collapse: collapse; font-size: 9pt; }
.note-slide-copy th, .note-slide-copy td { text-align: left; padding: 1mm 2mm; border-bottom: 0.2mm solid #d9dee6; }
.note-slide-copy .source { font-size: 8.5pt; margin-top: 2mm; }
.note-slide-copy .tag { font-size: 7.5pt; padding: 0.5mm 1.5mm; }

.note-body { font-size: 11.5pt; line-height: 1.5; }
.note-body p { margin: 0 0 3.5mm; }
.note-body ul { margin: 0 0 3.5mm; padding-left: 6mm; }
.note-body li { margin-bottom: 2mm; }
.note-body strong { font-weight: 700; }
.note-body blockquote {
  margin: 0 0 3.5mm;
  padding: 2mm 0 2mm 5mm;
  border-left: 1mm solid #2438d8;
  color: #11151c;
}
.note-body code {
  font-family: Consolas, "Cascadia Mono", monospace;
  font-size: 0.9em;
  background: #f4f6f9;
  padding: 0 1mm;
  border-radius: 0.8mm;
}

.note-foot {
  margin-top: 6mm;
  padding-top: 2.5mm;
  border-top: 0.3mm solid #d9dee6;
  font-size: 9pt;
  color: #7b8794;
}

.cover h1 { font-size: 26pt; margin: 0 0 3mm; }
.cover .sub { font-size: 13pt; color: #46525f; margin-bottom: 8mm; }
.cover table { width: 100%; border-collapse: collapse; font-size: 10pt; }
.cover th, .cover td { text-align: left; padding: 2mm 3mm; border-bottom: 0.3mm solid #d9dee6; vertical-align: top; }
.cover th { width: 46mm; color: #46525f; font-weight: 600; }
.cover .warn { margin-top: 8mm; padding: 4mm 5mm; background: #fdf3e6; border-left: 1.5mm solid #b45309; font-size: 10pt; line-height: 1.45; }
</style>
</head>
<body>

<div class="note-page cover">
  <h1>{{ document.title }} — speaker notes</h1>
  <p class="sub">{{ document.event }} · {{ document.author }} · {{ document.date }}</p>
  <table>
    <tr><th>Deck</th><td>{{ slides | length }} slides ({{ core_count }} core, {{ supporting_count }} supporting)</td></tr>
    <tr><th>Estimated speaking time</th><td>{{ total_minutes }} min at {{ wpm }} wpm, slides only — <strong>an estimate from the word count of these notes, not a measured rehearsal</strong></td></tr>
    <tr><th>Live demo</th><td>{{ demo_minutes }} min target, timed separately — <code>docs/presentation/demo-script.md</code></td></tr>
    <tr><th>Backup plan</th><td><code>docs/presentation/demo-backup-plan.md</code> — read it before presenting</td></tr>
    <tr><th>Jury questions</th><td><code>docs/presentation/jury-questions.md</code></td></tr>
    <tr><th>Built from</th><td>commit <code>{{ build_commit }}</code> on {{ built_on }}</td></tr>
  </table>
  <div class="warn">
    <strong>No authoritative presentation duration is recorded anywhere in this repository.</strong>
    The slide count is provisional. If a duration is set by the school, cut the
    <strong>supporting</strong> slides first — each one folds into the note of the slide beside it,
    so a shorter talk loses stage time and not a claim.
  </div>
</div>

{%- for slide in slides %}
<div class="note-page">
  <div class="note-head">
    <h2>{{ slide.title }}</h2>
    <span class="n">{{ slide.n }} / {{ slides | length }}</span>
  </div>
  <p class="note-meta">
    <span class="tier-{{ slide.tier }}">{{ slide.tier | upper }}</span>
    &nbsp;·&nbsp; {{ slide.layout }}
    &nbsp;·&nbsp; ~{{ slide.seconds }} s spoken ({{ slide.words }} words)
  </p>

  <p class="note-section-label">On the slide</p>
  <div class="note-slide-copy">{{ slide.html }}</div>

  <p class="note-section-label">Say</p>
  <div class="note-body">{{ slide.notes_html }}</div>

  {%- if slide.n == 25 %}
  <p class="note-foot"><strong>Hand off to the demo here.</strong> The timed script and the four-rung
  fallback ladder are separate documents — do not improvise either.</p>
  {%- else %}
  <p class="note-foot">Next: {{ next_titles[slide.n] }}</p>
  {%- endif %}
</div>
{%- endfor %}

</body>
</html>
