# Secrets and environment
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
dist/
build/
.vite/
coverage/

# Playwright: reports, traces, videos and downloaded browser binaries are all
# regenerable output. The browsers live in the user cache outside the repo.
playwright-report/
test-results/
.playwright/

# PID file written by scripts/start-demo.ps1 so stop-demo can stop only what it
# started, rather than killing processes by name.
.run/

# ML artifacts (large binaries stay out of Git by default)
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.onnx
models/
checkpoints/
.cache/
huggingface/
wandb/

# Dataset (raw data is not committed by default; manifests and samples are)
data/raw/
data/processed/
data/uploads/
!data/manifests/
!data/samples/

# Generated outputs and temporary files
outputs/
tmp/
temp/
*.log
logs/

# OS and editor junk
Thumbs.db
Desktop.ini
.DS_Store
*.swp
.idea/
.vscode/

# Claude Code local settings
.claude/settings.local.json

# Derived upload packages: duplicates of evidence already tracked under docs/evidence/.
#
# Ignore the CONTENTS, not the directory. `deliverables/` would exclude the
# directory itself, and Git does not descend into an excluded directory - so the
# negation below would never be reached and the report PDF could only be added
# with `git add -f`. `deliverables/*` keeps the directory traversable.
deliverables/*

# The research report PDF is a submitted deliverable and must be present in the
# GitHub result (M9, issue #10, acceptance criterion 4). One named file only: the
# intermediate build HTML and every other derived package stay ignored, and M10
# makes its own decision for the presentation PDF.
!deliverables/DeckForge-AI-research-report.pdf
